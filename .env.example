# ─── Server ───────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Public URL Twilio will POST webhooks to (ngrok for dev, real domain for prod)
BASE_URL=https://your-subdomain.ngrok.io

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600

# ─── Business Configuration ───────────────────────────────────────────────────
BUSINESS_NAME=Sunrise Dental
BUSINESS_PHONE_NUMBER=+1XXXXXXXXXX
BUSINESS_ADDRESS=123 Main St, Springfield, IL 62701

# Business timezone (from pytz — e.g. America/New_York, America/Chicago, America/Los_Angeles)
BUSINESS_TIMEZONE=America/Chicago

# JSON: day name → open/close in 24h HH:MM, or null for closed
BUSINESS_HOURS={"monday":{"open":"09:00","close":"17:00"},"tuesday":{"open":"09:00","close":"17:00"},"wednesday":{"open":"09:00","close":"17:00"},"thursday":{"open":"09:00","close":"17:00"},"friday":{"open":"09:00","close":"16:00"},"saturday":{"open":"10:00","close":"14:00"},"sunday":null}

# Comma-separated list of services
BUSINESS_SERVICES=Teeth Cleaning,Cavity Filling,Root Canal,Teeth Whitening,Emergency Dental,New Patient Consultation

# ─── ElevenLabs TTS (required for WebSocket pipeline) ────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ─── Deepgram STT (required for WebSocket pipeline) ──────────────────────────
DEEPGRAM_API_KEY=your_deepgram_key_here

# ─── Twilio warm transfer target ──────────────────────────────────────────────
TWILIO_HUMAN_AGENT_NUMBER=+1XXXXXXXXXX

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Set to "claude" (default) or "openai"
AI_PROVIDER=claude

# OpenAI (only required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
